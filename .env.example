HTTP_ADDR=:8080
LOG_LEVEL=info

DATABASE_URL=postgres://dispatcher:dispatcher@localhost:5433/webhook_dispatcher?sslmode=disable
REDIS_ADDR=localhost:6379

# Only used by DB-backed tests. Not read by the binary.
TEST_DATABASE_URL=postgres://dispatcher:dispatcher@localhost:5433/webhook_dispatcher_test?sslmode=disable

JWT_SECRET=replace-with-same-value-as-bookmarks-api
INGEST_TOKEN=replace-with-openssl-rand-base64-32

# CORS - Comma-separated list of allowed origins for webhook API
ALLOWED_ORIGINS=https://nuntix.com.br

TEST_REDIS_ADDR=localhost:6379